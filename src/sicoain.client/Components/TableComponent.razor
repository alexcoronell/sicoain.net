@namespace sicoain.client.Components

<PageTitle>@FullPageTitle</PageTitle>

<div>
    <MudText Typo="Typo.h4" Class="mb-4 text-center">@TitlePage</MudText>
    <MudDivider Class="mb-4" />

    <div Style="margin-bottom: 1rem;">
        <MudFab Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Href="@CreateUrl" />
    </div>

    <div>
        @ChildContent
    </div>
</div>

@code {
    private string baseTitle = "SICOAIN | ";

    [Parameter]
    public string TitlePage { get; set; } = string.Empty;

    [Parameter]
    public required string CreateUrl { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private string FullPageTitle => $"{baseTitle}{TitlePage}";
}
