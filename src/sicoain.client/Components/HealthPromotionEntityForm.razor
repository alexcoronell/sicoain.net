@using sicoain.client.Abstractions
@using sicoain.client.Exceptions
@using sicoain.shared.DTOs
@using sicoain.shared.DTOs.HealthPromotionEntities
@using sicoain.shared.Enums

@inject IHealthPromotionEntitiyService HealthPromotionEntityService
@inject NavigationManager Navigation

<MudForm @ref="_form" @bind-IsValid="@_success" @bind-Errors="@_errors"
         OnEnterPressed="@(() => { if (_form is not null) _form.ValidateAsync(); })" Class="w-100 mx-auto"
         Style="padding: 1.5rem; max-width: 600px">
    <MudTextField Class="w-100 mb-3" T="string" @bind-Value="@_name" Label="Nombre de la EPS" MaxLength="100"
                  MinLength="3" HelperText="Ingresa el nombre de la EPS" Required="true"
                  RequiredError="El nombre de la EPS es requerido!" For="@(() => _name)" Disabled="@(_isLoading)"
                  Validation="@ValidateName" />
    <MudTextField Class="w-100 mb-4" T="string" @bind-Value="@_addressStreet" Label="Dirección"
                  HelperText="Ingresa la dirección de la EPS (opcional)" For="@(() => _addressStreet)"
                  Disabled="@(_isLoading)" MaxLength="200" />

    @* --- Correos Electrónicos --- *@
    <MudText Typo="Typo.subtitle1" Class="mb-2 mt-4">Correos Electrónicos</MudText>
    <MudRadioGroup T="int?" @bind-Value="_selectedMainEmail">
        @foreach (var (item, index) in _emails.Select((e, i) => (e, i)))
        {
            <div class="d-flex align-center gap-2 mb-2">
                <MudRadio T="int?" Value="@GetItemId(item, index)" Color="Color.Primary" Size="Size.Small" />
                <MudTextField Class="flex-grow-1" T="string" @bind-Value="_emails[index].Value"
                              Label="Correo electrónico" Placeholder="correo@ejemplo.com"
                              Disabled="@(_isLoading)" Immediate="true" />
                <MudIconButton Icon="@Icons.Material.Filled.RemoveCircle" Color="Color.Error"
                               Disabled="@(_isLoading)" Size="Size.Small"
                               OnClick="@(() => RemoveEmail(index))" />
            </div>
        }
    </MudRadioGroup>
    <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AddCircle"
               Disabled="@(_isLoading)" Class="mb-4" OnClick="@AddEmail">
        Agregar correo
    </MudButton>

    @* --- Teléfonos --- *@
    <MudText Typo="Typo.subtitle1" Class="mb-2 mt-2">Teléfonos</MudText>
    <MudRadioGroup T="int?" @bind-Value="_selectedMainPhone">
        @foreach (var (item, index) in _phones.Select((p, i) => (p, i)))
        {
            <div class="d-flex align-center gap-2 mb-2">
                <MudRadio T="int?" Value="@GetItemId(item, index)" Color="Color.Primary" Size="Size.Small" />
                <MudSelect T="PhoneType" @bind-Value="_phones[index].PhoneType" Disabled="@(_isLoading)"
                           Density="Density.Compact" Variant="Variant.Text" Class="mr-2" Style="min-width: 100px;">
                    @foreach (PhoneType pt in Enum.GetValues<PhoneType>())
                    {
                        <MudSelectItem Value="pt">@pt</MudSelectItem>
                    }
                </MudSelect>
                <MudTextField Class="flex-grow-1" T="string" @bind-Value="_phones[index].Value"
                              Label="Teléfono" Placeholder="3001234567"
                              Disabled="@(_isLoading)" Immediate="true" />
                <MudIconButton Icon="@Icons.Material.Filled.RemoveCircle" Color="Color.Error"
                               Disabled="@(_isLoading)" Size="Size.Small"
                               OnClick="@(() => RemovePhone(index))" />
            </div>
        }
    </MudRadioGroup>
    <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AddCircle"
               Disabled="@(_isLoading)" Class="mb-4" OnClick="@AddPhone">
        Agregar teléfono
    </MudButton>

    @* --- Botones --- *@
    <div class="d-flex align-center justify-center gap-3 pt-3">
        <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Save" Color="Color.Success"
                   Disabled="@(_isLoading)" Size="Size.Large"
                   OnClick="@(async () => await HandleSaveAsync())">
            @(IsEditMode ? "Actualizar" : "Guardar")
        </MudButton>
        <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Cancel" Disabled="@(_isLoading)"
                   Size="Size.Large" Href="/eps">Volver</MudButton>
    </div>
</MudForm>
@if (_successMessage.Length > 0)
{
    <MudAlert Severity="Severity.Success" Class="mx-auto" Style="max-width: 600px;">@_successMessage</MudAlert>
}
@if (!string.IsNullOrEmpty(_errorMessage))
{
    <MudAlert Severity="Severity.Error" Class="mx-auto" Style="max-width: 600px;">
        @_errorMessage
    </MudAlert>
}

@code
{
    [Parameter] public HealthPromotionEntityDto? Entity { get; set; }

    private MudForm? _form;
    private bool _success;
    private string[] _errors = Array.Empty<string>();

    private string _name = string.Empty;
    private string _addressStreet = string.Empty;
    private List<EmailItem> _emails = [];
    private List<PhoneItem> _phones = [];
    private string _errorMessage = string.Empty;
    private string _successMessage = string.Empty;
    private bool _isLoading = false;
    private int? _selectedMainEmail;
    private int? _selectedMainPhone;

    private bool IsEditMode => Entity is not null;

    protected override void OnInitialized()
    {
        if (IsEditMode)
        {
            _name = Entity!.Name ?? string.Empty;
            _addressStreet = Entity.AddressStreet ?? string.Empty;
            _emails = Entity.Emails?.Select(e => new EmailItem
            {
                Id = e.Id,
                Value = e.Email,
                IsMain = e.IsMain
            }).ToList() ?? [];
            _phones = Entity.Phones?.Select(p => new PhoneItem
            {
                Id = p.Id,
                Value = p.PhoneNumber,
                IsMain = p.IsMain,
                PhoneType = p.PhoneType
            }).ToList() ?? [];

            var mainEmail = _emails.FirstOrDefault(e => e.IsMain);
            if (mainEmail is not null)
                _selectedMainEmail = mainEmail.Id ?? -(_emails.IndexOf(mainEmail) + 1);

            var mainPhone = _phones.FirstOrDefault(p => p.IsMain);
            if (mainPhone is not null)
                _selectedMainPhone = mainPhone.Id ?? -(_phones.IndexOf(mainPhone) + 1);
        }
    }

    private static int GetItemId(EmailItem item, int index)
        => item.Id ?? -(index + 1);

    private static int GetItemId(PhoneItem item, int index)
        => item.Id ?? -(index + 1);

    private string? ValidateName(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return null;

        if (value.Length < 3)
            return "El nombre debe tener al menos 3 caracteres.";

        if (value.Length > 100)
            return "El nombre no puede exceder los 100 caracteres.";

        return null;
    }

    private void AddEmail()
    {
        _emails.Add(new EmailItem());
        _selectedMainEmail = -_emails.Count;
    }

    private void RemoveEmail(int index)
    {
        _emails.RemoveAt(index);
        SyncMainEmailSelection();
    }

    private void AddPhone()
    {
        _phones.Add(new PhoneItem());
        _selectedMainPhone = -_phones.Count;
    }

    private void RemovePhone(int index)
    {
        _phones.RemoveAt(index);
        SyncMainPhoneSelection();
    }

    private void SyncMainEmailSelection()
    {
        if (_emails.Count == 0) { _selectedMainEmail = null; return; }
        if (_selectedMainEmail.HasValue && _emails.Any(e => GetItemId(e, _emails.IndexOf(e)) == _selectedMainEmail))
            return;
        _selectedMainEmail = GetItemId(_emails[0], 0);
    }

    private void SyncMainPhoneSelection()
    {
        if (_phones.Count == 0) { _selectedMainPhone = null; return; }
        if (_selectedMainPhone.HasValue && _phones.Any(p => GetItemId(p, _phones.IndexOf(p)) == _selectedMainPhone))
            return;
        _selectedMainPhone = GetItemId(_phones[0], 0);
    }

    private void SyncIsMainFromSelection()
    {
        foreach (var (email, index) in _emails.Select((e, i) => (e, i)))
            email.IsMain = GetItemId(email, index) == _selectedMainEmail;
        foreach (var (phone, index) in _phones.Select((p, i) => (p, i)))
            phone.IsMain = GetItemId(phone, index) == _selectedMainPhone;
    }

    private async Task HandleSaveAsync()
    {
        _errorMessage = string.Empty;
        _isLoading = true;
        StateHasChanged();

        if (_form is not null)
        {
            await _form.ValidateAsync();
            if (!_success)
            {
                _isLoading = false;
                return;
            }
        }

        try
        {
            if (IsEditMode)
            {
                await HandleUpdateAsync();
            }
            else
            {
                await HandleCreateAsync();
            }
        }
        catch (ApiException ex)
        {
            _errorMessage = ex.Message;
            _success = false;
            if (_form is not null) await _form.ValidateAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = "Ocurrió un error inesperado. Por favor, inténtalo de nuevo.";
            Console.Error.WriteLine($"Error: {ex.Message}");
            _success = false;
            if (_form is not null) await _form.ValidateAsync();
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ResetFormAsync()
    {
        _name = string.Empty;
        _addressStreet = string.Empty;
        _emails = [];
        _phones = [];
        _selectedMainEmail = null;
        _selectedMainPhone = null;
        if (_form is not null) await _form.ResetAsync();
    }

    private async Task HandleCreateAsync()
    {
        SyncIsMainFromSelection();
        var request = new CreateHealthPromotionEntityRequest
        {
            Name = _name,
            AddressStreet = string.IsNullOrWhiteSpace(_addressStreet) ? null : _addressStreet,
            Notes = null,
            Emails = _emails
                .Where(e => !string.IsNullOrWhiteSpace(e.Value))
                .Select(e => new CreateEntityEmailRequest
                {
                    Email = e.Value.Trim(),
                    IsMain = e.IsMain
                }).ToList(),
            Phones = _phones
                .Where(p => !string.IsNullOrWhiteSpace(p.Value))
                .Select(p => new CreateEntityPhoneRequest
                {
                    Phone = p.Value.Trim(),
                    IsMain = p.IsMain,
                    PhoneType = p.PhoneType
                }).ToList()
        };

        await HealthPromotionEntityService.CreateAsync(request);
        _successMessage = "La EPS fue guardada correctamente";
        StateHasChanged();
        await Task.Delay(3000);
        _successMessage = string.Empty;
        await ResetFormAsync();
        Navigation.NavigateTo("/eps");
    }

    private async Task HandleUpdateAsync()
    {
        SyncIsMainFromSelection();
        var request = new UpdateHealthPromotionEntityRequest
        {
            Name = string.IsNullOrWhiteSpace(_name) ? null : _name,
            AddressStreet = string.IsNullOrWhiteSpace(_addressStreet) ? null : _addressStreet,
            Notes = null,
            Emails = _emails
                .Where(e => !string.IsNullOrWhiteSpace(e.Value))
                .Select(e => new UpdateEntityEmailRequest
                {
                    Id = e.Id,
                    Email = e.Value.Trim(),
                    IsMain = e.IsMain
                }).ToList(),
            Phones = _phones
                .Where(p => !string.IsNullOrWhiteSpace(p.Value))
                .Select(p => new UpdateEntityPhoneRequest
                {
                    Id = p.Id,
                    Phone = p.Value.Trim(),
                    IsMain = p.IsMain,
                    PhoneType = p.PhoneType
                }).ToList()
        };

        await HealthPromotionEntityService.UpdateAsync(Entity!.Id, request);

        _successMessage = "La EPS fue actualizada correctamente";
        StateHasChanged();
        await Task.Delay(3000);
        _successMessage = string.Empty;
        Navigation.NavigateTo("/eps");
    }

    private class EmailItem
    {
        public int? Id { get; set; }
        public string Value { get; set; } = string.Empty;
        public bool IsMain { get; set; }
    }

    private class PhoneItem
    {
        public int? Id { get; set; }
        public string Value { get; set; } = string.Empty;
        public bool IsMain { get; set; }
        public PhoneType PhoneType { get; set; } = PhoneType.Mobile;
    }
}
