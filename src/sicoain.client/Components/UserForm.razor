@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using sicoain.client.Abstractions
@using sicoain.client.Providers
@using sicoain.shared.DTOs
@using sicoain.shared.DTOs.Roles
@using sicoain.shared.DTOs.Users

@inject IRoleService RoleService
@inject IUserService UserService

<MudForm @ref="_form" @bind-IsValid="@_success" @bind-Errors="@_errors"
         OnEnterPressed="@(() => { if (_form is not null) _form.ValidateAsync(); })" Class="mx-auto w-100"
         Style="padding: 1.5rem;">
    <MudTextField Class="w-100 mb-3" T="string" @bind-Value="@_fullname" Label="Nombre Completo" MaxLength=100
                  MinLength=2 HelperText="Ingresa el nombre completo" Required="true"
                  RequiredError="El nombre completo es requerido!" For="@(() => _fullname)" Disabled="@(_isLoading)"
                  Validation="@ValidateFullName" />
    <MudTextField Class="w-100 mb-3" T="string" @bind-Value="@_email" Label="Correo Electrónico"
                  HelperText="Ingresa el correo electrónico" Required="true" RequiredError="El email es requerido!"
                  For="@(() => _email)" Autocomplete="off" InputType="InputType.Email" Disabled="@(_isLoading)" />
    <MudTextField Class="w-100 mb-6" T="string" @bind-Value="@_password" Label="Contraseña"
                  @bind-Value:after="OnPasswordChanged" HelperText="Escribe tu contraseña" InputType="InputType.Password"
                  Required="true" RequiredError="La contraseña es requerida!" For="@(() => _password)" Autocomplete="new-password"
                  MinLength=8 Disabled="@(_isLoading)" />
    <MudTextField Class="w-100 mb-6" T="string" @bind-Value="@_confirmPassword" Label="Confirmar Contraseña"
                  HelperText="Corfirma la contraseña" InputType="InputType.Password" Required="true"
                  RequiredError="La confirmación de contraseña es requerida!" For="@(() => _confirmPassword)"
                  Autocomplete="new-password" Disabled="@(_isLoading)" Validation="@ValidateConfirmPassword" />
    <MudSelect T="string" Label="Roles" MultiSelection="true" @bind-SelectedValues="_selectedRoleNames"
               AnchorOrigin="Origin.BottomCenter" Class="w-100 mb-6" Disabled="@(_isLoading || _isLoadingRoles)"
               HelperText="Selecciona uno o más roles para el usuario" StringSelectionMode="SelectionMode.MultiSelection">
        @foreach (var role in _roleDtos)
        {
            <MudSelectItem Value="@role.Name">@role.Name</MudSelectItem>
        }
    </MudSelect>
    <div class="d-flex align-center justify-center gap-3 pt-3">
        <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Save" Color="Color.Success"
                   Disabled="@(_isLoading)" Size="Size.Large" OnClick="@(async () => await HandleSaveAsync())">Guardar
        </MudButton>
        <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Cancel" Disabled="@(_isLoading)"
                   Size="Size.Large" Href="/usuarios">Volver</MudButton>
    </div>
</MudForm>
@if (_successMessage.Length > 0)
{
    <MudAlert Severity="Severity.Success">@_successMessage</MudAlert>
}
@if (!string.IsNullOrEmpty(_errorMessage))
{
    <MudAlert Severity="Severity.Error">
        @_errorMessage
    </MudAlert>
}

@code
{
    private MudForm? _form;
    private bool _success;
    private string[] _errors = Array.Empty<string>();

    private string _email = string.Empty;

    private string _fullname = string.Empty;
    private string _password = string.Empty;
    private string _confirmPassword = string.Empty;
    private string _errorMessage = string.Empty;
    private string _successMessage = string.Empty;
    private bool _isLoading = false;
    private bool _isLoadingRoles = false;

    private IEnumerable<RoleDto> _roleDtos = [];
    private IReadOnlyCollection<string> _selectedRoleNames = [];

    protected override async Task OnInitializedAsync()
    {
        await GetAllRoles();
    }

    private async Task GetAllRoles()
    {
        _isLoadingRoles = true;
        StateHasChanged();
        try
        {
            PagedResponse<RoleDto>? response = await RoleService.GetAllAsync();
            _roleDtos = response.Items;
            Console.Write(response);
        }
        finally
        {
            _isLoadingRoles = false;
        }
    }
    private string? ValidateFullName(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return null;

        if (value.Length < 2)
            return "El nombre debe tener al menos 2 caracteres.";

        if (value.Length > 100)
            return "El nombre no puede exceder los 100 caracteres.";

        return null;
    }

    private string? ValidateConfirmPassword(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return null;

        if (_password != value)
            return "Las contraseñas no coinciden";

        return null;
    }

    private async Task OnPasswordChanged()
    {
        if (_form is not null) await _form.ValidateAsync();
    }

    private async Task HandleSaveAsync()
    {
        _errorMessage = string.Empty;
        _isLoading = true;
        StateHasChanged();

        if (_form is not null)
        {
            await _form.ValidateAsync();
            if (!_success)
            {
                _isLoading = false;
                return;
            }
        }

        CreateUserRequest? request = new CreateUserRequest
        {
            Email = _email,
            Password = _password,
            FullName = _fullname,
            Roles = _selectedRoleNames.Count > 0 ? [.. _selectedRoleNames] : null
        };

        try
        {
            var result = await UserService.CreateAsync(request);
            Console.WriteLine(result);
            _successMessage = "El usuario fue guardado correctamente";
            StateHasChanged();
            await Task.Delay(3000);
            _successMessage = string.Empty;
            if (_form is not null) await _form.ResetAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = "Ocurrió un error inesperado. Por favor, inténtalo de nuevo.";
            Console.Error.WriteLine($"Error: {ex.Message}");
            _success = false;
            if (_form is not null) await _form.ValidateAsync();
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }
}
