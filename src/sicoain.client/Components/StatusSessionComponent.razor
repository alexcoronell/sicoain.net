@using Microsoft.AspNetCore.Components.Authorization
@using sicoain.client.Abstractions
@using sicoain.client.Providers
@inject IAuthService AuthService
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Navigation

@if (_isAuthenticated)
{
    <MudText Typo="Typo.subtitle1" Class="mr-2 text-dark">
        Hola @_userName
    </MudText>
    <MudButton Variant="@Variant.Text" OnClick="HandleLogoutAsync">Salir</MudButton>
}

@code
{
    private string _userName = string.Empty;
    private bool _isAuthenticated = false;

    [Parameter]
    public EventCallback<bool> sendIsAuthenticated { get; set; }

    private async Task sendAuthStatusToParent()
    {
        await sendIsAuthenticated.InvokeAsync(_isAuthenticated);
    }

    private async Task LoadUserFromState()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            _userName = user.FindFirst("Fullname")?.Value ?? user.Identity.Name ?? "Usuario";
            _isAuthenticated = true;
        }
        else
        {
            _userName = string.Empty;
            _isAuthenticated = false;
        }
        await sendAuthStatusToParent();
    }

    protected override async Task OnInitializedAsync()
    {
        // Subscribe to state changes in the authentication state provider
        AuthProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
        await LoadUserFromState();
    }

    private async void OnAuthenticationStateChanged(Task<AuthenticationState> task)
    {
        await InvokeAsync(async () =>
        {
            await LoadUserFromState();
            StateHasChanged();
        });
    }

    private async Task HandleLogoutAsync()
    {
        await AuthService.LogoutAsync();
        var cursoProvider = AuthProvider as CustomAuthenticationStateProvider;
        cursoProvider?.MarkUserAsLoggedOut();
        Navigation.NavigateTo("/", false);
    }

    public void Dispose()
    {
        AuthProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
    }
}
