@using sicoain.client.Abstractions
@using sicoain.shared.DTOs
@using sicoain.shared.DTOs.Roles
@using sicoain.shared.DTOs.Permissions

@inject IRoleService RoleService
@inject IPermissionService PermissionService
@inject NavigationManager Navigation

<MudForm @ref="_form" @bind-IsValid="@_success" @bind-Errors="@_errors"
         OnEnterPressed="@(() => { if (_form is not null) _form.ValidateAsync(); })" Class="w-100"
         Style="padding: 1.5rem; max-width: 1200px; margin: 0 auto;">
    <MudGrid>
        <MudItem xs="12" md="6">
            <MudTextField Class="w-100 mb-3" T="string" @bind-Value="@_name" Label="Nombre del Rol" MaxLength=50
                          MinLength=5 HelperText="Nombre único del rol (mín. 5 caracteres)" Required="true"
                          RequiredError="El nombre del rol es requerido!" For="@(() => _name)" Disabled="@(_isLoading || IsEditMode)" />
        </MudItem>
        <MudItem xs="12" md="6">
            <MudTextField Class="w-100 mb-3" T="string" @bind-Value="@_description" Label="Descripción"
                          HelperText="Descripción del propósito del rol" Lines="3" MaxLength=500
                          Disabled="@(_isLoading)" />
        </MudItem>
        <MudItem xs="12">
            <MudSwitch @bind-Value="@_isActive" Class="mb-4" Color="Color.Primary" Disabled="@(_isLoading)">
                <ChildContent>
                    Rol activo
                </ChildContent>
            </MudSwitch>
        </MudItem>
    </MudGrid>

    @if (IsEditMode)
    {
        <MudText Typo="Typo.h6" Class="mt-4 mb-2">Permisos del Rol</MudText>

        @if (_isLoadingPermissions)
        {
            <div class="d-flex justify-center my-4">
                <MudProgressCircular Indeterminate="true" Size="Size.Medium" />
            </div>
        }
        else if (!string.IsNullOrEmpty(_permissionError))
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">@_permissionError</MudAlert>
        }
        else
        {
            <MudPaper Class="pa-4 mb-4" Elevation="0" Outlined="true">
                @if (_allPermissions.Count == 0)
                {
                    <MudText Typo="Typo.body2" Class="text-medium-emphasis">
                        No hay permisos disponibles.
                    </MudText>
                }
                else
                {
                    <MudGrid>
                        @foreach (var group in _permissionsByModule)
                        {
                            <MudItem xs="12" md="@_moduleColumnSize">
                                <MudText Typo="Typo.subtitle1" Class="mt-2 mb-1 font-weight-bold">
                                    @TranslateModule(group.Key)
                                </MudText>
                                @foreach (var permission in group.OrderBy(p => p.Name))
                                {
                                    <MudCheckBox T="bool" Color="Color.Primary"
                                                 Checked="@_selectedPermissionNames.Contains(permission.Name)"
                                                 CheckedChanged="@((bool val) => TogglePermission(permission.Name, val))"
                                                 Disabled="@(_isLoading)">
                                        <ChildContent>
                                            @TranslateAction(permission.Action)
                                        </ChildContent>
                                    </MudCheckBox>
                                }
                            </MudItem>
                        }
                    </MudGrid>
                }
            </MudPaper>
        }
    }

    <div class="d-flex align-center justify-center gap-3 pt-3">
        <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Save" Color="Color.Success"
                   Disabled="@(_isLoading)" Size="Size.Large"
                   OnClick="@(async () => await HandleSaveAsync())">
            @(IsEditMode ? "Actualizar" : "Guardar")
        </MudButton>
        <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Cancel" Disabled="@(_isLoading)"
                   Size="Size.Large" Href="/roles">Volver</MudButton>
    </div>
</MudForm>

@if (_successMessage.Length > 0)
{
    <MudAlert Severity="Severity.Success">@_successMessage</MudAlert>
}

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <MudAlert Severity="Severity.Error">
        @_errorMessage
    </MudAlert>
}

@code {
    [Parameter] public RoleDto? Role { get; set; }

    private MudForm? _form;
    private bool _success;
    private string[] _errors = Array.Empty<string>();

    private string _name = string.Empty;
    private string _description = string.Empty;
    private bool _isActive = true;
    private string _errorMessage = string.Empty;
    private string _successMessage = string.Empty;
    private bool _isLoading = false;

    private bool IsEditMode => Role is not null;

    // Permission-related fields
    private List<PermissionDto> _allPermissions = [];
    private HashSet<string> _selectedPermissionNames = [];
    private bool _isLoadingPermissions = false;
    private string _permissionError = string.Empty;

    private ILookup<string, PermissionDto> _permissionsByModule =>
        _allPermissions.ToLookup(p => p.Module);

    private int _moduleColumnSize
    {
        get
        {
            var moduleCount = _permissionsByModule.Count();
            if (moduleCount <= 2) return 6;
            if (moduleCount <= 4) return 4;
            return 3;
        }
    }

    private static string TranslateModule(string module)
    {
        return module switch
        {
            "Accidents" => "Accidentes",
            "Employees" => "Empleados",
            "Reports"   => "Reportes",
            "Users"     => "Usuarios",
            "Settings"  => "Configuración",
            _           => module
        };
    }

    private static string TranslateAction(string action)
    {
        return action switch
        {
            "View"       => "Ver",
            "Create"     => "Crear",
            "Edit"       => "Editar",
            "Delete"     => "Eliminar",
            "Approve"    => "Aprobar",
            "Export"     => "Exportar",
            "AssignRoles" => "Asignar Roles",
            "Manage"     => "Gestionar",
            _            => action
        };
    }

    protected override void OnParametersSet()
    {
        if (IsEditMode)
        {
            _name = Role!.Name;
            _description = Role.Description;
            _isActive = Role.IsActive;
        }
        else
        {
            _name = string.Empty;
            _description = string.Empty;
            _isActive = true;
            _allPermissions.Clear();
            _selectedPermissionNames.Clear();
            _permissionError = string.Empty;
        }

        _successMessage = string.Empty;
        _errorMessage = string.Empty;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (IsEditMode)
        {
            await LoadPermissionsAsync();
        }
    }

    private async Task LoadPermissionsAsync()
    {
        _isLoadingPermissions = true;
        _permissionError = string.Empty;
        StateHasChanged();

        try
        {
            _allPermissions = await PermissionService.GetAllAsync();
            var currentPermissions = await PermissionService.GetRolePermissionsAsync(Role!.Id);
            _selectedPermissionNames = [.. currentPermissions];
        }
        catch (Exception ex)
        {
            _permissionError = "Error al cargar los permisos. Por favor, intenta de nuevo.";
            Console.Error.WriteLine($"Error loading permissions: {ex.Message}");
        }
        finally
        {
            _isLoadingPermissions = false;
            StateHasChanged();
        }
    }

    private void TogglePermission(string permissionName, bool isSelected)
    {
        if (isSelected)
            _selectedPermissionNames.Add(permissionName);
        else
            _selectedPermissionNames.Remove(permissionName);
    }

    private async Task HandleSaveAsync()
    {
        _errorMessage = string.Empty;
        _isLoading = true;
        StateHasChanged();

        if (_form is not null)
        {
            await _form.ValidateAsync();
            if (!_success)
            {
                _isLoading = false;
                return;
            }
        }

        try
        {
            if (IsEditMode)
            {
                await HandleUpdateAsync();
            }
            else
            {
                await HandleCreateAsync();
            }
        }
        catch (Exception ex)
        {
            _errorMessage = "Ocurrió un error inesperado. Por favor, inténtalo de nuevo.";
            Console.Error.WriteLine($"Error: {ex.Message}");
            _success = false;
            if (_form is not null) await _form.ValidateAsync();
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task HandleCreateAsync()
    {
        var request = new CreateRoleRequest
        {
            Name = _name,
            Description = _description,
            IsActive = _isActive
        };

        await RoleService.CreateAsync(request);
        _successMessage = "El rol fue guardado correctamente";
        StateHasChanged();
        await Task.Delay(3000);
        _successMessage = string.Empty;
        if (_form is not null) await _form.ResetAsync();
    }

    private async Task HandleUpdateAsync()
    {
        var request = new UpdateRoleRequest
        {
            Description = _description,
            IsActive = _isActive
        };

        await RoleService.UpdateAsync(Role!.Id, request);

        // Sync permissions: add new ones, remove unselected ones
        var currentPermissions = (await PermissionService.GetRolePermissionsAsync(Role.Id)).ToList();
        var selectedPermissions = _selectedPermissionNames.ToList();

        var permissionsToAdd = selectedPermissions.Except(currentPermissions);
        var permissionsToRemove = currentPermissions.Except(selectedPermissions);

        foreach (var perm in permissionsToAdd)
            await PermissionService.AssignPermissionAsync(Role.Id, perm);

        foreach (var perm in permissionsToRemove)
            await PermissionService.RemovePermissionAsync(Role.Id, perm);

        _successMessage = "El rol fue actualizado correctamente";
        StateHasChanged();
        await Task.Delay(3000);
        _successMessage = string.Empty;
    }
}
