@using sicoain.client.Abstractions
@using sicoain.shared.DTOs
@using sicoain.shared.DTOs.Business

@inject IBusinessService BusinessService
@page "/empresas"
@attribute [Authorize]
<PageTitle>SICOAIN | Sistema de Control de Accidentes e Incidentes | Empresas</PageTitle>

<TableComponent TitlePage="Empresas" CreateUrl="@CreateUrl">

    <MudTable Items="@Elements" ServerData="@LoadServerData" Hover="true" Loading="@_loading"
              FixedHeader="@fixed_header" FixedFooter="@fixed_footer" Height="@(fixed_header || fixed_footer ?"350px":"")"
              LoadingProgressColor="Color.Info" Class="w-full" Style="min-width: 1200px;">
        <HeaderContent>
            <MudTh>Id</MudTh>
            <MudTh>Nombre</MudTh>
            <MudTh>Direción</MudTh>
            <MudTh>Correo(s)</MudTh>
            <MudTh>Teléfono(s)</MudTh>
            <MudTh Class="text-center">Acciones</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Id">@context.Id</MudTd>
            <MudTd DataLabel="Fullname">@context.Name</MudTd>
            <MudTd DataLabel="Dirección">@context.AddressStreet</MudTd>
            <MudTd DataLabel="Correo(s)">
                @if (context.Emails?.Any() == true)
                {
                    var main = context.Emails.FirstOrDefault(e => e.IsMain) ?? context.Emails.First();
                    <a href="mailto:@main.Email" style="text-decoration: underline; cursor: pointer;">@main.Email</a>
                    @if (context.Emails.Count > 1)
                    {
                        <span class="text-caption ml-1 text-medium-emphasis">+@(context.Emails.Count - 1)</span>
                    }
                }
            </MudTd>
            <MudTd DataLabel="Teléfono(s)">
                @if (context.Phones?.Any() == true)
                {
                    var main = context.Phones.FirstOrDefault(p => p.IsMain) ?? context.Phones.First();
                    <a href="tel:@main.PhoneNumber" style="text-decoration: underline; cursor: pointer;">@main.PhoneNumber</a>
                    @if (context.Phones.Count > 1)
                    {
                        <span class="text-caption ml-1 text-medium-emphasis">+@(context.Phones.Count - 1)</span>
                    }
                }
            </MudTd>
            <MudTd>
                <div style="display: flex; justify-content: center; gap: 8px; align-items: center; width: 100%;">
                <MudFab Color="Color.Info" Size="Size.Small" StartIcon="@Icons.Material.Filled.Edit"
                        Href="@($"/empresas/editar/{context.Id}")" />
                <MudFab Color="Color.Error" Size="Size.Small" StartIcon="@Icons.Material.Filled.Delete" />
                </div>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Class="text-center pa-8" Typo="Typo.body2" Color="Color.Default">
                No hay empresas registradas.
            </MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager PageSizeOptions="@_pageSizeOptions" RowsPerPageString="@rowsPerPageString"
                           InfoFormat="@infoFormat" AllItemsText="@allItemsText" />
        </PagerContent>
    </MudTable>

</TableComponent>

@code {
    private bool _loading;
    private IEnumerable<BusinessDto> Elements = new List<BusinessDto>();
    private readonly bool fixed_header = true;
    private readonly bool fixed_footer = true;
    private readonly string rowsPerPageString = "Items por página:";
    private readonly string infoFormat = "{first_item}-{last_item} - Total {all_items} usuarios";
    private readonly string allItemsText = "Todos";
    private readonly string CreateUrl = "/empresas/crear";
    private int[] _pageSizeOptions = new[] { 10, 25, 50, 100 };

    private static int[] ComputePageSizeOptions(int totalItems)
    {
        if (totalItems <= 10)
            return new[] { totalItems };

        if (totalItems < 25)
            return new[] { 10, totalItems };

        if (totalItems < 50)
            return new[] { 10, 25, totalItems };

        return new[] { 10, 25, 50, 100, totalItems };
    }

    private async Task<TableData<BusinessDto>> LoadServerData(TableState state, CancellationToken cancellationToken)
    {
        _loading = true;
        StateHasChanged();

        try
        {
            PagedResponse<BusinessDto>? response = await BusinessService.GetAllAsync(
                pageNumber: state.Page + 1,
                pageSize: state.PageSize);

            Elements = response.Items;
            _pageSizeOptions = ComputePageSizeOptions(response.TotalCount);

            return new TableData<BusinessDto>
            {
                Items = response.Items,
                TotalItems = response.TotalCount
            };
        }
        finally
        {
            _loading = false;
        }
    }
}
