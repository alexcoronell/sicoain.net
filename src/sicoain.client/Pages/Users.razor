@using System.Net.Http.Json
@inject HttpClient httpClient
@using sicoain.client.Abstractions
@using sicoain.client.Services
@using sicoain.shared.DTOs
@using sicoain.shared.DTOs.Users
@using static MudBlazor.CategoryTypes

@inject IUserService UserService
@page "/usuarios"
<PageTitle>SICOAIN | Sistema de Control de Accidentes e Incidentes | Usuarios</PageTitle>

<div style="padding: 20px; border-radius: 8px; background-color: #f5f5f5;">
    <h1>Usuarios</h1>
    <MudDivider />
    <MudTable Items="@Elements" Hover="true" Loading="@_loading" LoadingProgressColor="Color.Info">
        <HeaderContent>
            <MudTh>Id</MudTh>
            <MudTh>Fullname</MudTh>
            <MudTh>Email</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Id">@context.Id</MudTd>
            <MudTd DataLabel="Fullname">@context.FullName</MudTd>
            <MudTd DataLabel="Email">@context.Email</MudTd>
        </RowTemplate>
    </MudTable>
</div>

@code {
    private bool _loading;
    private int _totalItems;
    private int _currentPage = 1;
    private int _pageSize = 10;
    private int _totalPages = 0;
    private bool _hasPreviousPage = false;
    private bool _hasNextPage = false;
    private IEnumerable<UserDto> Elements = new List<UserDto>();

    private async Task LoadDataAsync(int page = 1, int pageSize = 10)
    {
        _loading = true;

        try
        {
            var response = await UserService.GetAllAsync(page, pageSize);

            Elements = response.Items;
            _totalItems = response.TotalCount;
            _currentPage = response.PageNumber;
            _pageSize = response.PageSize;
            _totalPages = response.TotalPages;
            _hasPreviousPage = response.HasPreviousPage;
            _hasNextPage = response.HasNextPage;
        }
        finally
        {
            _loading = false;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }
}
