@using sicoain.client.Abstractions
@using sicoain.client.Services
@using sicoain.shared.DTOs
@using sicoain.shared.DTOs.Users
@using sicoain.client.Components
@using MudBlazor

@inject IUserService UserService
@page "/usuarios"

<TableComponent TitlePage="Usuarios" CreateUrl="@CreateUrl">

    <MudTable Items="@Elements" ServerData="@LoadServerData" Hover="true" Loading="@_loading"
              FixedHeader="@fixed_header" FixedFooter="@fixed_footer" Height="@(fixed_header || fixed_footer ?"350px":"")"
              LoadingProgressColor="Color.Info" Class="w-full" Style="min-width: 600px; max-width: 800px;">
        <HeaderContent>
            <MudTh>Id</MudTh>
            <MudTh>Nombre completo</MudTh>
            <MudTh>Correo Electrónico</MudTh>
            <MudTh Class="text-center">Acciones</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Id">@context.Id</MudTd>
            <MudTd DataLabel="Fullname">@context.FullName</MudTd>
            <MudTd DataLabel="Email">@context.Email</MudTd>
            <MudTd Class="flex gap-3 justify-center items-center">
                <MudFab Color="Color.Info" Size="Size.Small" StartIcon="@Icons.Material.Filled.Edit"
                        Href="@($"/usuarios/editar/{context.Id}")" />
                <MudFab Color="Color.Error" Size="Size.Small" StartIcon="@Icons.Material.Filled.Delete" />
            </MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager PageSizeOptions="@_pageSizeOptions" RowsPerPageString="@rowsPerPageString"
                           InfoFormat="@infoFormat" AllItemsText="@allItemsText" />
        </PagerContent>
    </MudTable>
</TableComponent>

@code {
    private bool _loading;
    private IEnumerable<UserDto> Elements = new List<UserDto>();
    private readonly bool fixed_header = true;
    private readonly bool fixed_footer = true;
    private readonly string rowsPerPageString = "Items por página:";
    private readonly string infoFormat = "{first_item}-{last_item} - Total {all_items} usuarios";
    private readonly string allItemsText = "Todos";
    private readonly string CreateUrl = "/usuarios/crear";
    private int[] _pageSizeOptions = new[] { 10, 25, 50, 100 };

    private static int[] ComputePageSizeOptions(int totalItems)
    {
        if (totalItems <= 10)
            return new[] { totalItems };

        if (totalItems < 25)
            return new[] { 10, totalItems };

        if (totalItems < 50)
            return new[] { 10, 25, totalItems };

        return new[] { 10, 25, 50, 100, totalItems };
    }

    private async Task<TableData<UserDto>> LoadServerData(TableState state, CancellationToken cancellationToken)
    {
        _loading = true;
        StateHasChanged();

        try
        {
            PagedResponse<UserDto>? response = await UserService.GetAllAsync(
                pageNumber: state.Page + 1,
                pageSize: state.PageSize);

            Elements = response.Items;
            _pageSizeOptions = ComputePageSizeOptions(response.TotalCount);

            return new TableData<UserDto>
            {
                Items = response.Items,
                TotalItems = response.TotalCount
            };
        }
        finally
        {
            _loading = false;
        }
    }
}
