@using sicoain.client.Abstractions
@using sicoain.client.Services
@using sicoain.shared.DTOs
@using sicoain.shared.DTOs.Users
@using sicoain.client.Components

@inject IUserService UserService
@inject NavigationManager Navigation
@page "/usuarios/editar/{Id:int}"
@attribute [Authorize]

<div style="width: 100%;">
    <MudText Typo="Typo.h2" Class="text-center block">
        Editar Usuario
    </MudText>

    @if (_loadingUser)
    {
        <MudProgressCircular Indeterminate="true" Class="mx-auto" />
    }
    else if (_notFound)
    {
        <MudAlert Severity="Severity.Warning">Usuario no encontrado</MudAlert>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/usuarios" Class="mt-3">
            Volver a usuarios
        </MudButton>
    }
    else if (_user is not null)
    {
        <div style="max-width: 500px; width: 100%; margin: 0 auto;">
            <UserForm User="@_user" />
        </div>
    }
</div>

@code
{
    [Parameter] public int Id { get; set; }

    private UserDto? _user;
    private bool _loadingUser = true;
    private bool _notFound;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _user = await UserService.GetByIdAsync(Id);
            _notFound = _user is null;
        }
        catch
        {
            _notFound = true;
        }
        finally
        {
            _loadingUser = false;
        }
    }
}
