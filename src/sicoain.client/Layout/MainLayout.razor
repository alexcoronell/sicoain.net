@inherits LayoutComponentBase
@* Required *@
<MudThemeProvider />
<MudPopoverProvider />

@* Needed for dialogs *@
<MudDialogProvider />

@* Needed for snackbars *@
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@ToggleDrawer" />
        <MudSpacer />
        <MudIconButton Icon="@Icons.Custom.Brands.GitHub" Color="Color.Inherit" Href="https://github.com/MudBlazor/MudBlazor" Target="_blank" />
    </MudAppBar>
    <MudDrawer @bind-Open="@_open" Elevation="1">
        <MudDrawerHeader>
            <MudText Typo="Typo.h6">My App</MudText>
        </MudDrawerHeader>
        <MudNavMenu>
            <MudNavLink Match="NavLinkMatch.All">Empresas</MudNavLink>
            <MudNavLink Match="NavLinkMatch.All">Sedes</MudNavLink>
            <MudNavLink Match="NavLinkMatch.All">EPS</MudNavLink>
            <MudNavLink Match="NavLinkMatch.All">ARL</MudNavLink>
            <MudNavLink Match="NavLinkMatch.All">Empleados</MudNavLink>
            <MudNavLink Match="NavLinkMatch.All">Usuarios</MudNavLink>
        </MudNavMenu>
    </MudDrawer>
    <MudMainContent Class="pt-16 px-16">
        <MudContainer Class="d-flex justify-center align-center" style="min-height: 75vh;">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code{
    private bool _open = false;

    private void ToggleDrawer()
    {
        _open = !_open;
    }
}
