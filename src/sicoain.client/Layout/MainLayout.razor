@inherits LayoutComponentBase
<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<MudLayout>
    <MudAppBar Elevation="2" Color="Color.Tertiary">
        <MudIconButton
            Icon="@Icons.Material.Filled.Menu"
            Color="Color.Dark"
            Edge="Edge.Start"
            OnClick="@ToggleDrawer" />
        <MudSpacer />
        <MudText Typo="Typo.h6" Class="text-dark">
            Sistema de Control de Accidentes e Incidentes
        </MudText>
        <MudSpacer />
        <MudText Typo="Typo.subtitle1" Class="mr-2 text-dark">
            Hola
        </MudText>
        <MudChip Color="Color.Dark">Nombre de Usuario</MudChip>
        <MudButton Variant="Text">Salir</MudButton>
    </MudAppBar>
    <MudDrawer @bind-Open="@_open" Elevation="2">
        <MudDrawerHeader>
            <MudText Typo="Typo.h6">SICOAIN</MudText>
        </MudDrawerHeader>
        <NavMenu />
    </MudDrawer>
    <MudMainContent Class="pt-16 px-16">
        <MudContainer Class="d-flex justify-center align-center" Style="min-height: 75vh;">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code
{
    private bool _open = false;

    private void ToggleDrawer()
    {
        _open = !_open;
    }
}
