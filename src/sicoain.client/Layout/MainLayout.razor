@inherits LayoutComponentBase
<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<MudLayout>
    <MudAppBar Elevation="2" Color="Color.Tertiary" Class="relative">
        @if (_isAuthenticated)
        {
            <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Dark" Edge="Edge.Start"
                           OnClick="@ToggleDrawer" />
            <MudSpacer />
        }
        <MudText Typo="Typo.h6" Class="text-dark" Style="position: absolute; left: 50%; transform: translateX(-50%);">
            Sistema de Control de Accidentes e Incidentes
        </MudText>
        <MudSpacer />
        <StatusSessionComponent sendIsAuthenticated="authStatusChanged" />
    </MudAppBar>
    <MudDrawer @bind-Open="@_open" Elevation="2">
        <MudDrawerHeader>
            <MudText Typo="Typo.h6">SICOAIN</MudText>
        </MudDrawerHeader>
        <NavMenu />
    </MudDrawer>
    <MudMainContent Class="pt-16 px-16">
        <MudContainer Class="d-flex justify-center align-center" Style="min-height: 75vh;">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code
{
    private bool _open = false;
    private bool _isAuthenticated = false;

    private void ToggleDrawer()
    {
        _open = !_open;
    }

    private async Task authStatusChanged(bool isAuthenticated)
    {
        _isAuthenticated = isAuthenticated;
        StateHasChanged();
    }
}
